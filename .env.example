# ==============================================================================
# NexLearn AI — Environment Configuration Template
# Copy this file to .env and replace placeholders with your credentials.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon Serverless PostgreSQL)
# https://neon.tech
# ------------------------------------------------------------------------------
# Pooled connection string (recommended for serverless queries / Next.js)
DATABASE_URL="postgresql://user:password@ep-xyz-pooler.region.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct unpooled connection string (required for migrations / prisma db push)
DIRECT_DATABASE_URL="postgresql://user:password@ep-xyz.region.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 2. NextAuth Authentication Configuration
# ------------------------------------------------------------------------------
# Application base URL (http://localhost:3000 in dev, https://yourdomain.com in prod)
NEXTAUTH_URL="http://localhost:3000"

# Generate a strong 32+ byte secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-32-character-random-secret-key-here"

# ------------------------------------------------------------------------------
# 3. AI Engines (Groq SDK & Google Gemini)
# https://console.groq.com | https://aistudio.google.com
# ------------------------------------------------------------------------------
# Groq API Key (Used for streaming AI Mentor & course generation with Llama 3.3)
GROQ_API_KEY="gsk_your_groq_api_key_here"

# Google Gemini API Keys (Used for content generation & multimodal tasks)
GOOGLE_GENERATIVE_AI_API_KEY="your-google-gemini-api-key"
GEMINI_API_KEY="your-google-gemini-api-key"

# ------------------------------------------------------------------------------
# 4. Transactional Email Service (Brevo / Sendinblue)
# https://app.brevo.com
# ------------------------------------------------------------------------------
# Brevo v3 API Key for sending OTP verification and welcome emails
BREVO_API_KEY="xkeysib-your-brevo-api-key-here"
BREVO_SENDER_EMAIL="noreply@yourdomain.com"
BREVO_SENDER_NAME="NexLearn"

# ------------------------------------------------------------------------------
# 5. Google OAuth 2.0 (Social Sign-In)
# https://console.cloud.google.com/apis/credentials
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"
